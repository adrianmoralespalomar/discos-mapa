{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Discos Mapa",
  "mainBinaryName": "discos-mapa",
  "version": "0.3.0",
  "identifier": "com.adrianmoralespalomar.discosmapa",
  "build": {
    "frontendDist": "../dist/discos-mapa/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Discos Mapa",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Mapa de los discos y ayuda para liberar espacio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
